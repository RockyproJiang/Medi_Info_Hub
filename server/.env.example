# ===== 服务端环境变量 =====
# 复制为 server/.env 后按实际情况修改。真实 .env 已被 .gitignore 排除，切勿提交。

# 服务端口（nginx 反代指向这里）
PORT=8787

# 令牌签名密钥：必须换成足够长的随机串
#   生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# SQLite 内容库路径（相对 server/ 目录；首次启动自动建表并写入种子数据）
DB_PATH=./data/yinling.db

# ===== AI 模块（DeepSeek，OpenAI 兼容接口）=====
# 到 https://platform.deepseek.com 申请自己的 Key 填进来，留空则 AI 顾问不可用，其余功能不受影响
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ===== MySQL 用户数据库（用户/档案/测算记录/收藏/测评/AI会话/笔记/审计）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=yinling_ark
